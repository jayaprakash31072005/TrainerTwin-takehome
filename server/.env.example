# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=



# Cartesia (STT/TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Groq (LLM) — used by bot.py
GROQ_API_KEY=
# Optional:
# GROQ_MODEL=openai/gpt-oss-20b

# OpenAI (optional; not used by default bot)
OPENAI_API_KEY=
OPENAI_MODEL=
